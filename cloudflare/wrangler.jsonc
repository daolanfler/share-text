{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "share-text-storage-api",
    "main": "worker.js",
    "compatibility_date": "2026-09-04",
    "preview_urls": false,
    "observability": {
        "enabled": true,
        "logs": {
            "enabled": true
        }
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "ONE_TIME_TEXTS",
                "class_name": "OneTimeText"
            }
        ]
    },
    "exports": {
        "OneTimeText": {
            "type": "durable-object",
            "storage": "sqlite"
        }
    },
    "kv_namespaces": [
        {
            "binding": "TEXTS",
            "id": "99cd03df6c7345d485c9b0275dc63d63"
        }
    ]
}
